rules_version = '2';

// Cloud Firestore security rules for Career Bridge.
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore Database → Rules).
//
// Phase 6 · Milestone 2 hardening: beyond auth + ownership, writes now assert a
// data contract — identity fields (ownerUid / applicantUid / companyId) are
// immutable on update, and free-text fields are size-capped to stop a
// compromised or tampered client from bloating or rewriting a document. The
// checks are intentionally *tolerant* (absent / null passes) so they can never
// deny a write the existing models already produce — a too-strict rule would
// terminate the live snapshot listener until relaunch (see HANDOFF §7.13).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Reusable helpers -------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    // A field keeps its stored value across an update (or is absent from both).
    // Only compares scalars the app writes consistently — never re-serialized
    // maps/dates, whose type can legitimately shift between writes.
    function unchanged(field) {
      return (!(field in request.resource.data) && !(field in resource.data))
        || request.resource.data[field] == resource.data[field];
    }

    // A free-text field is absent, null, or a string no longer than [max].
    function capped(field, max) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= max);
    }

    // A user may read and write only their own profile document at
    // users/{uid}. Free-text fields are size-capped.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
                      && capped('displayName', 120)
                      && capped('headline', 200)
                      && capped('location', 200)
                      && capped('bio', 4000);

      // Learning interests at users/{uid}/learning/{docId} (Phase 7 · Milestone
      // 4). A small owner-private document (the `interests` doc) holding the
      // seeker's career paths / skills / technologies / industries / goals. Only
      // the owner may read or write; uid is scoped by the parent path.
      match /learning/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Company documents at companies/{companyId} (companyId == owner uid in
    // Milestone 1). Readable by any signed-in user (future job listings surface
    // the company), writable only by the owning employer. Split create/update
    // like the other collections: create pins ownership; update keeps ownerUid
    // immutable. (A combined `allow write` with unchanged('ownerUid') denied the
    // very first write, because on create `resource` is null and the immutability
    // check errors — so ensureCompany + the first Save never persisted, leaving
    // the profile stuck at its baseline completion.) name/description are capped.
    match /companies/{companyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == companyId
                       && request.resource.data.ownerUid == companyId
                       && capped('name', 200)
                       && capped('description', 4000);
      allow update: if signedIn() && request.auth.uid == companyId
                       && unchanged('ownerUid')
                       && capped('name', 200)
                       && capped('description', 4000);
    }

    // Job postings at jobs/{jobId} (Phase 5 · Milestone 2). A published job is
    // readable by any signed-in user (the seeker platform); a draft/archived/
    // closed job only by its owner. Create pins ownership; update/delete are
    // owner-only and can't repoint ownerUid. Free-text fields are capped.
    match /jobs/{jobId} {
      allow read: if signedIn() &&
                     (resource.data.status == 'published' ||
                      resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       capped('title', 200) &&
                       capped('description', 20000) &&
                       capped('status', 40);
      allow update: if signedIn() &&
                       resource.data.ownerUid == request.auth.uid &&
                       unchanged('ownerUid') &&
                       capped('title', 200) &&
                       capped('description', 20000) &&
                       capped('status', 40);
      allow delete: if signedIn() &&
                       resource.data.ownerUid == request.auth.uid;
    }

    // Job applications at applications/{applicationId}.
    // Dual-keyed: the seeker (applicantUid) creates + withdraws their own; the
    // job owner (ownerUid) reads + updates status (moves through the pipeline).
    //
    // The create path is the one a malicious client would attack, because the
    // client supplies ownerUid — the field that decides whose applicant list the
    // document lands in. Three things are therefore asserted on create:
    //
    //  1. applicantUid == the caller. Nobody can file an application as someone
    //     else.
    //  2. ownerUid is CORROBORATED AGAINST THE REFERENCED JOB, not trusted. A
    //     real posting must exist at jobs/{jobId} and its ownerUid must match,
    //     so an application cannot be injected into an arbitrary employer's
    //     pipeline. The demo catalogue (`assets/data/seed_jobs.json`) has no
    //     Firestore document behind it, so applying to a demo job is permitted
    //     only with an EMPTY ownerUid — which no employer query can ever match.
    //  3. status starts at 'pending'. An applicant cannot self-advance the
    //     pipeline (e.g. create themselves as 'accepted').
    //
    // Free-text and the denormalized applicant snapshot are size-capped, like
    // every other collection, so a tampered client can't bloat the document the
    // employer's list renders.
    //
    // Updates remain OWNER-ONLY: status is employer-controlled. An applicant
    // withdraws by deleting, never by editing. Identity fields stay immutable.
    match /applications/{applicationId} {
      function jobPath(jobId) {
        return /databases/$(database)/documents/jobs/$(jobId);
      }

      // The claimed ownerUid is the referenced job's real owner, or the job is
      // not a Firestore posting at all and no employer is claimed.
      function ownerMatchesJob() {
        let claimed = request.resource.data.ownerUid;
        let jobId = request.resource.data.jobId;
        return (exists(jobPath(jobId))
                  && get(jobPath(jobId)).data.ownerUid == claimed)
            || (!exists(jobPath(jobId)) && claimed == '');
      }

      allow read: if signedIn() &&
                     (resource.data.applicantUid == request.auth.uid ||
                      resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() &&
                       request.resource.data.applicantUid == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       ownerMatchesJob() &&
                       capped('jobTitle', 200) &&
                       capped('company', 200) &&
                       capped('companyName', 200) &&
                       capped('location', 200) &&
                       capped('note', 5000) &&
                       capped('cvName', 200);
      allow update: if signedIn() &&
                       resource.data.ownerUid == request.auth.uid &&
                       unchanged('applicantUid') &&
                       unchanged('ownerUid') &&
                       unchanged('companyId') &&
                       unchanged('jobId') &&
                       capped('note', 5000);
      allow delete: if signedIn() &&
                       resource.data.applicantUid == request.auth.uid;
    }

    // Private employer notes at applicationNotes/{noteId}. Only the owning
    // employer (ownerUid) may read or write — never the applicant. ownerUid is
    // immutable and the note body is capped.
    match /applicationNotes/{noteId} {
      allow create: if signedIn() &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       capped('text', 5000);
      allow read, delete: if signedIn() &&
                       resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() &&
                       resource.data.ownerUid == request.auth.uid &&
                       unchanged('ownerUid') &&
                       capped('text', 5000);
    }

    // CV repository at resumes/{resumeId} (Phase 7 · Milestone 3). Each CV
    // belongs only to its owner (ownerUid) — no cross-user reads. Create pins
    // ownership; update/delete are owner-only and can't repoint ownerUid.
    // Free-text fields (name) are capped; the content/analysis maps are the
    // app's own serialized models.
    match /resumes/{resumeId} {
      allow read: if signedIn() &&
                     resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       capped('name', 200);
      allow update: if signedIn() &&
                       resource.data.ownerUid == request.auth.uid &&
                       unchanged('ownerUid') &&
                       capped('name', 200);
      allow delete: if signedIn() &&
                       resource.data.ownerUid == request.auth.uid;
    }

    // Owner-private employer activity log at employerActivity/{id} — the
    // foundation for future auditing. Append-only: only the owner may create or
    // read (no update/delete), so the trail can't be rewritten.
    match /employerActivity/{activityId} {
      allow create: if signedIn() &&
                       request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() &&
                     resource.data.ownerUid == request.auth.uid;
    }

    // Everything else is denied by default (no fall-through match).
  }
}
