rules_version = '2';

// Cloud Firestore security rules for Career Bridge.
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore Database → Rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // A user may read and write only their own profile document at
    // users/{uid}. The app writes users/<auth uid> from UserProfileRepository.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Company documents at companies/{companyId} (companyId == owner uid in
    // Milestone 1). Readable by any signed-in user (future job listings surface
    // the company), writable only by the owning employer.
    match /companies/{companyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == companyId;
    }

    // Job postings at jobs/{jobId} (Phase 5 · Milestone 2). A published job is
    // readable by any signed-in user (the seeker platform); a draft/archived/
    // closed job only by its owner. Create requires the new doc to be owned by
    // the caller; updates/deletes are restricted to the owner. Soft-delete is a
    // normal update (deletedAt set), so no delete rule is needed, but it is kept
    // for completeness.
    match /jobs/{jobId} {
      allow read: if request.auth != null &&
                     (resource.data.status == 'published' ||
                      resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null &&
                       request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null &&
                               resource.data.ownerUid == request.auth.uid;
    }

    // Everything else is denied by default (no fall-through match).
  }
}
