rules_version = '2';

// Cloud Storage security rules for Career Bridge.
//
// Deploy with:  firebase deploy --only storage
// (or paste into Firebase Console → Storage → Rules).
service firebase.storage {
  match /b/{bucket}/o {

    // A user may read and write only files under their own space at
    // users/{uid}/**. The app writes users/<auth uid>/profile.jpg (profile
    // photos) and users/<auth uid>/resumes/** from CloudStorageService.
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Company logos at companies/{companyId}/logo.jpg (companyId == owner uid).
    // Readable by any signed-in user; writable only by the owning employer.
    match /companies/{companyId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == companyId;
    }

    // Everything else is denied by default (no fall-through match).
  }
}
